++ (id<FBResponsePayload>)handleMirrorProbe:(FBRouteRequest *)request
+{
+  NSString *action=request.arguments[@"action"] ?: @"state";
+  if([action isEqual:@"show"])return FBResponseWithObject([FBMirrorTouchProbe show]);
+  if([action isEqual:@"reset"]){
+    if(FBMirrorTouchProbe.shared.active.count || FBMirrorStreamingExperiment.shared.active)return FBResponseWithStatus([FBCommandStatus invalidElementStateErrorWithMessage:@"Release contacts before resetting probe" traceback:nil]);
+    [FBMirrorTouchProbe.shared reset];
+  } else if(![action isEqual:@"state"])return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"Unknown probe action" traceback:nil]);
+  return FBResponseWithObject(FBMirrorTouchProbe.shared.snapshot);
+}
++ (id<FBResponsePayload>)handleMirrorStream:(FBRouteRequest *)request
+{
+  NSError *error=nil; NSDictionary *result=[FBMirrorStreamingExperiment.shared command:request.arguments error:&error];
+  return result ? FBResponseWithObject(result) : FBResponseWithUnknownError(error);
+}
