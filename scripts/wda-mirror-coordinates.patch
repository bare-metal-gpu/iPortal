+// XCPointerEventPath takes portrait screen coordinates, even when its event
+// record names a landscape interface. XCUICoordinate.screenPoint performs this
+// conversion for ordinary W3C actions; the direct path must do it explicitly.
+static CGPoint FBMirrorPortraitPoint(CGPoint point, CGSize orientedSize, NSInteger orientation)
+{
+  switch (orientation) {
+    case 2: return CGPointMake(orientedSize.width - point.x, orientedSize.height - point.y);
+    case 3: return CGPointMake(orientedSize.height - point.y, point.x); // interface landscape right
+    case 4: return CGPointMake(point.y, orientedSize.width - point.x); // interface landscape left
+    default: return point;
+  }
+}
