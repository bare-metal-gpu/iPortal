++ (id<FBResponsePayload>)handleMirrorKeepalive:(FBRouteRequest *)request
+{
+  if (request.arguments.count != 0) {
+    return FBResponseWithStatus([FBCommandStatus invalidArgumentErrorWithMessage:@"keepalive accepts an empty object only" traceback:nil]);
+  }
+  if (XCUIDevice.sharedDevice.fb_isScreenLocked) {
+    return FBResponseWithStatus([FBCommandStatus invalidElementStateErrorWithMessage:@"Device is locked" traceback:nil]);
+  }
+  // Ordinary performDeviceEvent waits a hardcoded 5s for ButtonEventsCompleted for this usage.
+  // Replay the SAME HID event through the event-stream path; await XCTest playback completion.
+  // The stream contains no touches, text or volume keys. No unsigned/unacknowledged local HID dispatch.
+  static void *recap;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{ recap = dlopen("/System/Library/PrivateFrameworks/Recap.framework/Recap", RTLD_LAZY); });
+  Class<FBMirrorRecapStream> streamClass = NSClassFromString(@"RCPSyntheticEventStream");
+  Class<FBMirrorRecapSender> senderClass = NSClassFromString(@"RCPEventSenderProperties");
+  if (!recap || ![streamClass respondsToSelector:@selector(eventStreamWithEventActions:)]
+      || ![senderClass respondsToSelector:@selector(touchScreenDigitizerSender)]) {
+    return FBResponseWithStatus([FBCommandStatus unsupportedOperationErrorWithMessage:@"Keepalive event stream unavailable on this runtime" traceback:nil]);
+  }
+  id sender = [senderClass touchScreenDigitizerSender];
+  __block BOOL composed = NO;
+  id<FBMirrorRecapStream> stream = [streamClass eventStreamWithEventActions:^(id<FBMirrorRecapComposer> composer) {
+    if (![composer respondsToSelector:@selector(composeWithSender:actionBlock:)]) return;
+    [composer composeWithSender:sender actionBlock:^(id<FBMirrorRecapComposer> scopedComposer) {
+      if (![scopedComposer respondsToSelector:@selector(pressButtonsWithPages:usages:duration:)]) return;
+      [scopedComposer pressButtonsWithPages:@[@12] usages:@[@688] duration:0.01];
+      composed = YES;
+    }];
+  }];
+  NSData *data = [stream respondsToSelector:@selector(dataRepresentation)] ? stream.dataRepresentation : nil;
+  if (!composed || !data.length) {
+    return FBResponseWithStatus([FBCommandStatus unsupportedOperationErrorWithMessage:@"Could not compose keepalive event stream" traceback:nil]);
+  }
+  XCPointerEventPath *path = [[XCPointerEventPath alloc] initForEventStream:data frame:CGRectMake(0, 0, 1, 1) speed:1];
+  XCSynthesizedEventRecord *record = [[XCSynthesizedEventRecord alloc] initWithName:@"mirror-keepalive" interfaceOrientation:UIInterfaceOrientationPortrait];
+  [record addPointerEventPath:path];
+  if (XCUIDevice.sharedDevice.fb_isScreenLocked) {
+    return FBResponseWithStatus([FBCommandStatus invalidElementStateErrorWithMessage:@"Device is locked" traceback:nil]);
+  }
+  NSError *error = nil;
+  CFAbsoluteTime started = CFAbsoluteTimeGetCurrent();
+  // The high-level eventSynthesizer gates all raw streams on HID *recording* v2.
+  // This helper only plays a fixed synthetic stream; ask the daemon directly and
+  // await its normal completion. This acknowledges daemon playback; the 0.3s
+  // implicit confirmation interval is NOT proof of settled UI or an idle-timer
+  // reset. Idle-timer behavior needs a physical test. Unsupported playback is an error.
+  __block volatile atomic_bool completed = false;
+  __block NSError *playbackError = nil;
+  [XCTRunnerDaemonSession.sharedSession.daemonProxy _XCT_synthesizeEvent:record
+                                         implicitConfirmationInterval:0.3
+                                                           completion:^(NSError *innerError) {
+    playbackError = innerError;
+    atomic_store_explicit(&completed, true, memory_order_release);
+  }];
+  BOOL replied = [[[[[FBRunLoopSpinner new] interval:0.01] timeout:8] timeoutErrorMessage:@"Keepalive playback outcome unknown: daemon did not acknowledge within 8 seconds"]
+                 spinUntilTrue:^BOOL{ return atomic_load_explicit(&completed, memory_order_acquire); } error:&error];
+  if (!replied || playbackError) return FBResponseWithUnknownError(playbackError ?: error);
+  return FBResponseWithObject(@{@"completed":@YES, @"method":@"hid-event-stream", @"elapsedMs":@((CFAbsoluteTimeGetCurrent() - started) * 1000)});
+}
