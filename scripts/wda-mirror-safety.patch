+// Small, pure helpers are also compiled by scripts/test-native-contract.mjs.
+static BOOL FBMirrorFiniteNumber(id value)
+{
+  return [value isKindOfClass:NSNumber.class]
+    && CFGetTypeID((__bridge CFTypeRef)value) != CFBooleanGetTypeID()
+    && isfinite([value doubleValue]);
+}
+
+static BOOL FBMirrorValidPoints(id points, id end)
+{
+  if (![points isKindOfClass:NSArray.class] || [points count] < 1 || [points count] > 256
+      || !FBMirrorFiniteNumber(end) || [end doubleValue] < 0 || [end doubleValue] > 10000) return NO;
+  double previous = 0;
+  for (NSUInteger i = 0; i < [points count]; i++) {
+    id p = points[i];
+    if (![p isKindOfClass:NSArray.class] || [p count] != 3
+        || !FBMirrorFiniteNumber(p[0]) || !FBMirrorFiniteNumber(p[1]) || !FBMirrorFiniteNumber(p[2])) return NO;
+    double x = [p[0] doubleValue], y = [p[1] doubleValue], t = [p[2] doubleValue];
+    if (x < 0 || x > 1 || y < 0 || y > 1 || t < previous || t > [end doubleValue] || (i == 0 && t != 0)) return NO;
+    previous = t;
+  }
+  return YES;
+}
+
+static CGSize FBMirrorOrientedSize(CGSize size, NSInteger orientation)
+{
+  CGFloat shortSide = MIN(size.width, size.height), longSide = MAX(size.width, size.height);
+  return orientation == 3 || orientation == 4 ? CGSizeMake(longSide, shortSide) : CGSizeMake(shortSide, longSide);
+}
+
+static NSString *FBMirrorOrientationName(NSInteger orientation)
+{
+  switch (orientation) {
+    case 1: return @"PORTRAIT";
+    case 2: return @"UIA_DEVICE_ORIENTATION_PORTRAIT_UPSIDEDOWN";
+    case 3: return @"LANDSCAPE";
+    case 4: return @"UIA_DEVICE_ORIENTATION_LANDSCAPERIGHT";
+    default: return nil;
+  }
+}
+
+static BOOL FBMirrorReadOrientation(UIInterfaceOrientation *orientation, NSError **error)
+{
+  __block volatile atomic_bool completed = false;
+  __block NSInteger value = 0;
+  __block NSError *failure = nil;
+  id<XCUIDeviceEventAndStateInterface> state = XCUIDevice.sharedDevice.deviceEventAndStateInterface;
+  [state getInterfaceOrientationWithReply:^(NSInteger result, NSError *innerError) {
+    value = result; failure = innerError; atomic_store_explicit(&completed, true, memory_order_release);
+  }];
+  BOOL replied = [[[[[FBRunLoopSpinner new] interval:0.01] timeout:2] timeoutErrorMessage:@"Timed out reading interface orientation"]
+                 spinUntilTrue:^BOOL{ return atomic_load_explicit(&completed, memory_order_acquire); } error:error];
+  if (!replied) return NO;
+  if (failure || value < 1 || value > 4) {
+    if (error) *error = failure ?: [NSError errorWithDomain:@"iportal" code:1 userInfo:@{NSLocalizedDescriptionKey:@"Unknown interface orientation"}];
+    return NO;
+  }
+  *orientation = (UIInterfaceOrientation)value;
+  return YES;
+}
