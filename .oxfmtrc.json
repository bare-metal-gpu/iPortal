{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": ["node_modules/**", "vendor/**", "dist/**", "bun.lock", "**/Package.resolved"]
}
